# ISMS processing node — copy to backend/.env and adjust.
# Defaults assume the Raspberry Pi runs the API, Ollama and the kiosk HMI.

# --- API ---
PI_HOST=127.0.0.1
PI_PORT=8000
PI_BIND_HOST=0.0.0.0
DASHBOARD_API_URL=http://127.0.0.1:8000

# --- Ollama (local LLM explanation layer) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
OLLAMA_TIMEOUT_S=180
OLLAMA_MIN_INTERVAL_S=90

# --- Models ---
ANOMALY_MODEL_PATH=anomaly_model.pkl

# --- Detection thresholds ---
CRACK_WARN=0.45
CRACK_CRITICAL=0.75
RUST_WARN=0.06
FAULT_RMS_THRESHOLD=0.7

# --- Hull vision tuning (calibrated on real ESP32 frames) ---
BREAK_CONTRAST_MIN=38
BREAK_LEN_MIN=40
PLATE_MACRO_MAX=32

# --- Deployment helpers (deploy/pi.py, deploy/deploy_pi.py) ---
PI_SSH_HOST=192.168.1.100
PI_SSH_USER=pi
PI_SSH_PASS=
